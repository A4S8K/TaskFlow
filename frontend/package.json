    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.3",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "25.10.10",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "16.6.6",
    "react-router-dom": "7.18.4",
