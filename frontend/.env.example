# Public backend origin only. Never put secrets in VITE_ variables.
# Local development example. Vercel Preview/Production requires the real public
# HTTPS backend origin without a trailing path, credentials, query or fragment.
VITE_API_MODE=external
VITE_API_URL=http://localhost:8000
# Docker production only: VITE_API_MODE=same-origin and an empty VITE_API_URL.
# same-origin is forbidden on Vercel, where no backend proxy is configured.
