# Local development template. Never commit an actual .env file.
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://taskflow:CHANGE_ME@localhost:5432/taskflow
# Generate a random secret locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET remains a supported legacy alias; set only one alias per setting.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-web
# ACCESS_TOKEN_MINUTES remains a supported legacy alias.
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# JSON arrays and comma-separated values are both accepted; no wildcard origins.
CORS_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Only actual reverse proxy IPs/CIDRs; never use *. The local server has no remote proxy.
TRUSTED_PROXY_IPS=127.0.0.1
# The authentication limiter is process-local: exactly one worker AND one backend instance.
WEB_CONCURRENCY=1
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
AUTH_RATE_MAX_KEYS=10000
# Bounds simultaneous Argon2/password processing on small backend instances.
AUTH_MAX_CONCURRENT=2
# Supabase direct or session connections only; transaction pooling is not supported.
DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
# Before APP_ENV=production, explicitly configure DATABASE_URL, JWT_SECRET_KEY,
# FRONTEND_URL, BACKEND_URL, CORS_ORIGINS, TRUSTED_HOSTS and TRUSTED_PROXY_IPS.
# Public URLs/origins require HTTPS. DEBUG must remain false.
# DATABASE_URL requires sslmode=verify-full plus sslrootcert=/path/to/trusted-ca.pem
# (or sslrootcert=system with a compatible libpq), and the actual provider hostname.
# Obtain the exact Supabase direct/session URL from Connect, never use port 6543.
# See docs/DEPLOYMENT.md for production values, proxy trust and certificate setup.
